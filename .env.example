# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase (Postgres metadata only; storage moved to R2) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Cloudflare R2: client-side (safe in the browser bundle) ---
VITE_R2_PUBLIC_IMAGES=       # public URL for the product-images bucket
VITE_R2_PUBLIC_MODELS=       # public URL for the product-models bucket
VITE_API_BASE=               # usually empty (same-domain functions)

# --- Cloudflare R2: server-side secrets (Vercel env + `vercel dev`) ---
# Do NOT prefix with VITE_ — these must never reach the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_IMAGES=product-images
R2_BUCKET_MODELS=product-models
R2_PUBLIC_IMAGES=
R2_PUBLIC_MODELS=

# --- Supabase: server-side auth verification (Vercel env) ---
# SUPABASE_PUBLISHABLE_KEY can be the same public value as VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- One-time local admin bootstrap only; never expose or set as VITE_* ---
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
